# ==========================================
# BaliTowerOps Configuration
# ==========================================

# Application Settings
APP_NAME=BaliTowerOps
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8050
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Corporate LLM Gateway
LLM_URL=http://10.7.1.21/v1
LLM_KEY=your_api_key_here
API_LLM=http://10.7.1.21/v1

# Active AI Model Configuration (Active Model: qwen-38)
MODEL_NAME=qwen-38
MODEL_URL=http://localhost:8001/v1
MODEL_API_KEY=dummy-key-for-local

# Storage Paths
STORAGE_DIR=storage
DATA_DIR=data

# Email SMTP Setup (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
DEFAULT_RECIPIENT_EMAIL=manager@company.com
